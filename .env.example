# TKP environment variables — sample
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Production + Preview values are managed in Vercel:
#   Project Settings → Environment Variables
#   (or via the CLI: `vercel env add <NAME> <environment>`)
#
# NEVER commit `.env*.local` — they are gitignored intentionally.

# ---------------------------------------------------------------------------
# Required for production
# ---------------------------------------------------------------------------

# Canonical absolute URL for the deployed site. Used by:
#   src/lib/seo.ts        buildMetadata() metadataBase, canonical, hreflang, og:url, og:image
#   src/app/layout.tsx    JSON-LD Organization.url + LocalBusiness.url
#   src/app/sitemap.ts    <loc> entries
#   src/app/robots.ts     sitemap pointer
#
# Without this, all absolute URLs fall back to http://localhost:3000 — which
# breaks OG image fetching on Telegram, Slack, Facebook, etc. (because they
# can't reach localhost).
#
# Set per environment in Vercel:
#   Production:  https://tkpcarton.com         (once the domain is pointed)
#                https://tkp-pi.vercel.app     (fallback to the canonical Vercel URL)
#   Preview:     leave blank — falls back to localhost (preview deploys use
#                their own ephemeral URLs that change per push; not worth
#                pinning a value here)
#   Development: leave blank — http://localhost:3000 is the default
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Auto-injected by Vercel — do not set
# ---------------------------------------------------------------------------

# VERCEL_ENV is set by Vercel automatically: "production" | "preview" | "development"
# Used by src/app/robots.ts to emit "Disallow: /" on preview deployments so
# preview URLs don't leak into search results.
# VERCEL_ENV=
